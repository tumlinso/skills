#!/usr/bin/env python3
"""Legacy executable entrypoint; the optional skill lives in tumlinso/ctxpp."""
from pathlib import Path
import os
import shutil
import sys

self_path = Path(__file__).resolve()
override = os.environ.get("CTXPP_COMMAND")
if override:
    candidate = shutil.which(override) if os.sep not in override else os.path.expanduser(override)
    candidates = [candidate] if candidate else []
else:
    candidates = [str(Path(part) / "ctxpp") for part in os.get_exec_path()]
    candidates.append(str(Path.home() / ".local" / "bin" / "ctxpp"))
for candidate in candidates:
    path = Path(candidate)
    if path.is_file() and os.access(path, os.X_OK) and path.resolve() != self_path:
        os.execv(str(path), [str(path), *sys.argv[1:]])
print("Install standalone ctxpp from https://github.com/tumlinso/ctxpp, or set CTXPP_COMMAND to its executable.", file=sys.stderr)
sys.exit(127)
